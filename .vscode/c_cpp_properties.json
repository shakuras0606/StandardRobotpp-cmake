{
    "configurations": [
        {
            "name": "STM32F407 (GCC)",
            "compileCommands": "${workspaceFolder}/build/compile_commands.json",
            "compilerPath": "D:\\arm-gnu-toolchain\\bin\\arm-none-eabi-gcc.exe",
            "defines": [
                "USE_HAL_DRIVER",
                "STM32F407xx",
                "ARM_MATH_CM4",
                "__FPU_USED=1U",
                "__FPU_PRESENT=1U",
                "ARM_MATH_MATRIX_CHECK",
                "ARM_MATH_ROUNDING"
            ],
            "cStandard": "gnu11",
            "intelliSenseMode": "gcc-arm",
            "compilerArgs": [
                "-mthumb",
                "-mcpu=cortex-m4",
                "-mfpu=fpv4-sp-d16",
                "-mfloat-abi=hard"
            ]
        }
    ],
    "version": 4
}
