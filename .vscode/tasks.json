{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "build",
            "type": "shell",
            "command": "cmake --build build",
            "group": { "kind": "build", "isDefault": true },
            "problemMatcher": []
        },
        {
            "label": "flash (OpenOCD CMSIS-DAP)",
            "type": "shell",
            "command": "D:/edge download/OpenOCD-20260302-0.12.0/bin/openocd.exe",
            "args": [
                "-s",
                "D:/edge download/OpenOCD-20260302-0.12.0/share/openocd/scripts",
                "-f",
                "interface/cmsis-dap.cfg",
                "-c",
                "transport select swd",
                "-c",
                "adapter speed 400",
                "-f",
                "target/stm32f4x.cfg",
                "-c",
                "program build/standard_robot.elf verify reset exit"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": "build",
            "problemMatcher": []
        },
        {
            "type": "cppbuild",
            "label": "C/C++: arm-none-eabi-gcc.exe 生成活动文件",
            "command": "D:\\arm-gnu-toolchain\\bin\\arm-none-eabi-gcc.exe",
            "args": [
                "-fdiagnostics-color=always",
                "-g",
                "${file}",
                "-o",
                "${fileDirname}\\${fileBasenameNoExtension}.exe",
                "-mthumb",
                "-mcpu=cortex-m4",
                "-mfpu=fpv4-sp-d16",
                "-mfloat-abi=hard"
            ],
            "options": {
                "cwd": "${fileDirname}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": "build",
            "detail": "调试器生成的任务。"
        }
    ]
}

