{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Orbit Debug (DAPLink STM32F407)",
            "type": "orbit",
            "request": "launch",
            "device": "STM32F407IG",
            "probe": "cmsis-dap",
            "program": "${workspaceFolder}/build/standard_robot.elf",
            "svdFile": "${workspaceFolder}/debug/STM32F407.svd",
            "rtos": "FreeRTOS",
            "runToEntryPoint": "main",
            "flashBeforeDebug": false
        },
        {
            "name": "OpenOCD CMSIS-DAP (SWD)",
            "type": "cortex-debug",
            "request": "launch",
            "cwd": "${workspaceFolder}",
            "servertype": "openocd",
            "serverpath": "D:/edge download/OpenOCD-20260302-0.12.0/bin/openocd.exe",
            "device": "STM32F407IGHx",
            "executable": "${workspaceFolder}/build/standard_robot.elf",
            "configFiles": [
                "interface/cmsis-dap.cfg",
                "target/stm32f4x.cfg"
            ],
            "openocdPreConfigCommands": [
                "transport select swd",
                "adapter speed 4000"
            ],
            "runToEntryPoint": "main",
            "svdFile": "${workspaceFolder}/debug/STM32F407.svd",
            "showRegisters": true,
            "rtos": "FreeRTOS",
            "liveWatch": {
                "enabled": true,
                "samplesPerSecond": 4
            }
        },
        {
            "name": "OpenOCD CMSIS-DAP Debug (-Og)",
            "type": "cortex-debug",
            "request": "launch",
            "cwd": "${workspaceFolder}",
            "servertype": "openocd",
            "serverpath": "D:/edge download/OpenOCD-20260302-0.12.0/bin/openocd.exe",
            "device": "STM32F407IGHx",
            "executable": "${workspaceFolder}/build-debug/standard_robot.elf",
            "configFiles": [
                "interface/cmsis-dap.cfg",
                "target/stm32f4x.cfg"
            ],
            "openocdPreConfigCommands": [
                "transport select swd",
                "adapter speed 4000"
            ],
            "runToEntryPoint": "main",
            "svdFile": "${workspaceFolder}/debug/STM32F407.svd",
            "showRegisters": true,
            "rtos": "FreeRTOS",
            "liveWatch": {
                "enabled": true,
                "samplesPerSecond": 4
            }
        },
        {
            "name": "OpenOCD ST-Link (SWD)",
            "type": "cortex-debug",
            "request": "launch",
            "cwd": "${workspaceFolder}",
            "servertype": "openocd",
            "serverpath": "D:/edge download/OpenOCD-20260302-0.12.0/bin/openocd.exe",
            "device": "STM32F407IGHx",
            "executable": "${workspaceFolder}/build/standard_robot.elf",
            "configFiles": [
                "interface/stlink.cfg",
                "target/stm32f4x.cfg"
            ],
            "openocdPreConfigCommands": [
                "transport select hla_swd",
                "adapter speed 4000"
            ],
            "runToEntryPoint": "main",
            "svdFile": "${workspaceFolder}/debug/STM32F407.svd",
            "showRegisters": true,
            "rtos": "FreeRTOS",
            "liveWatch": {
                "enabled": true,
                "samplesPerSecond": 4
            }
        }
    ]
}
